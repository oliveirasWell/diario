generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  year          Int
  ownerId       String     @db.ObjectId
  daysOfWeek    Int[]      @default([])
  startDate     DateTime?
  endDate       DateTime?
  excludedDates DateTime[] @default([])
  invitedUserIds String[]   @default([])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  enrollments Enrollment[]
  evaluations Evaluation[]
  sessions    AttendanceSession[]
}

model Student {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  email      String?
  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  enrollments Enrollment[]
}

model Enrollment {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  classId    String  @db.ObjectId
  studentId  String  @db.ObjectId
  status     String  @default("ACTIVE")
  concept    String?

  class      Class   @relation(fields: [classId], references: [id])
  student    Student @relation(fields: [studentId], references: [id])
  grades     Grade[]
  attendance AttendanceRecord[]
}

model Evaluation {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  classId   String  @db.ObjectId
  title     String
  weight    Float?  @default(1)
  maxScore  Float   @default(10)
  createdAt DateTime @default(now())

  class     Class   @relation(fields: [classId], references: [id])
  grades    Grade[]
}

model Grade {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  enrollmentId  String  @db.ObjectId
  evaluationId  String  @db.ObjectId
  score         Float

  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id])
  evaluation    Evaluation @relation(fields: [evaluationId], references: [id])

  @@unique([enrollmentId, evaluationId])
}

model AttendanceSession {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  classId   String   @db.ObjectId
  date      DateTime
  notes     String?

  class     Class @relation(fields: [classId], references: [id])
  records   AttendanceRecord[]
}

model AttendanceRecord {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId    String   @db.ObjectId
  enrollmentId String   @db.ObjectId
  status       AttendanceStatus

  session      AttendanceSession @relation(fields: [sessionId], references: [id])
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])

  @@unique([sessionId, enrollmentId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model Location {
  id   String       @id @default(auto()) @map("_id") @db.ObjectId
  code String       @unique
  kind LocationKind
  name String

  roomShifts RoomShift[]
}

model Teacher {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  normalizedName String @unique

  lessons Lesson[]
}

model Subject {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  normalizedName String @unique

  lessons Lesson[]
}

model ClassGroup {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  grade   String
  section String

  roomShifts RoomShift[]

  @@unique([grade, section])
}

model RoomShift {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  locationId   String  @db.ObjectId
  shift        Shift
  classGroupId String? @db.ObjectId

  location   Location    @relation(fields: [locationId], references: [id])
  classGroup ClassGroup? @relation(fields: [classGroupId], references: [id])
  lessons    Lesson[]

  @@unique([locationId, shift])
}

model Lesson {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  roomShiftId String  @db.ObjectId
  weekday     Weekday
  period      Int
  subjectId   String  @db.ObjectId
  teacherId   String  @db.ObjectId

  roomShift RoomShift @relation(fields: [roomShiftId], references: [id])
  subject   Subject   @relation(fields: [subjectId], references: [id])
  teacher   Teacher   @relation(fields: [teacherId], references: [id])

  @@unique([roomShiftId, weekday, period])
}

enum LocationKind {
  ROOM
  POI
}

enum Shift {
  MATUTINO
  VESPERTINO
  NOTURNO
}

enum Weekday {
  SEG
  TER
  QUA
  QUI
  SEX
}
